# FastAPI origin used by the same-origin /api/v1 rewrite (server side only).
API_PROXY_TARGET=http://127.0.0.1:8000
# Auth: "dev" (POST /api/v1/auth/dev-login; API must run with ENV=dev, AUTH_MODE=dev) or "oidc".
NEXT_PUBLIC_AUTH_MODE=dev
# OIDC (authorization code + PKCE, public client). Required when NEXT_PUBLIC_AUTH_MODE=oidc.
NEXT_PUBLIC_OIDC_ISSUER=
NEXT_PUBLIC_OIDC_CLIENT_ID=
NEXT_PUBLIC_OIDC_SCOPE=openid profile email
NEXT_PUBLIC_OIDC_AUDIENCE=
# Kiosk at /kiosk (mirrors apps/kiosk VITE_* settings).
NEXT_PUBLIC_KIOSK_API_BASE=
NEXT_PUBLIC_KIOSK_MODE=public
NEXT_PUBLIC_SITE_MODE=supervised
NEXT_PUBLIC_KIOSK_ARM=B_fixed
NEXT_PUBLIC_PX_PER_MM=
# Dev-only placeholder voice (Web Speech). Ignored in production builds.
NEXT_PUBLIC_DEV_VOICE_PLACEHOLDER=false
# Rows above which an export asks for a written justification (PRV-08 governance rule).
NEXT_PUBLIC_EXPORT_JUSTIFICATION_ROWS=50
# Component gallery at /design-system in production builds (always on in dev).
NEXT_PUBLIC_ENABLE_UI_GALLERY=false
