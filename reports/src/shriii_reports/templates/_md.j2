{#- Markdown macro set. _html.j2 and _qmd.j2 expose the same macro names and signatures. -#}
{% macro doc_start() -%}
---
title: {{ report.title | yaml_str }}
study: {{ report.study_id | yaml_str }}
stage: {{ report.stage | yaml_str }}
status: {{ report.status | yaml_str }}
analysis_run_id: {{ prov.analysis_run_id | yaml_str }}
snapshot_sha256: {{ prov.snapshot_sha256 | yaml_str }}
bundle_sha256: {{ bundle_sha256 | yaml_str }}
---

{% endmacro %}

{% macro doc_end() -%}
{% endmacro %}

{% macro h(level, text) -%}
{{ '#' * level }} {{ text | prose }}

{% endmacro %}

{% macro p(text) -%}
{{ text | prose }}

{% endmacro %}

{% macro ul(items) -%}
{% for i in items %}
- {{ i | prose }}
{% endfor %}

{% endmacro %}

{% macro table(headers, rows) -%}
| {% for c in headers %}{{ c | cell }} | {% endfor %}

|{% for c in headers %} --- |{% endfor %}

{% for r in rows %}
| {% for c in r %}{{ c | cell }} | {% endfor %}

{% endfor %}

{% endmacro %}

{% macro kv(pairs) -%}
| Item | Value |
| --- | --- |
{% for k, v in pairs %}
| {{ k | cell }} | {{ v | cell }} |
{% endfor %}

{% endmacro %}

{% macro callout(kind, title, body) -%}
> **{{ kind | upper }}: {{ title | prose }}**
>
> {{ body | prose }}

{% endmacro %}

{% macro review(who, text) -%}
> **[REVIEW REQUIRED: {{ who | prose }}]** {{ text | prose }}

{% endmacro %}

{% macro placeholder(text) -%}
> **[TO BE COMPLETED]** {{ text | prose }}

{% endmacro %}
