{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shriii.local/contracts/session-context.v1.schema.json",
  "title": "SessionContext",
  "description": "Per-session covariate and configuration record (plan section 6.2). Emitted in the session.context event and stored with the session.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "$ref": "common.v1.schema.json#/$defs/minor_schema_version"
    },
    "session_id": {
      "$ref": "common.v1.schema.json#/$defs/uuidv7"
    },
    "language": {
      "anyOf": [
        {
          "$ref": "common.v1.schema.json#/$defs/language_tag"
        },
        {
          "type": "null"
        }
      ]
    },
    "age_band": {
      "anyOf": [
        {
          "$ref": "common.v1.schema.json#/$defs/age_band"
        },
        {
          "type": "null"
        }
      ]
    },
    "literacy_band": {
      "anyOf": [
        {
          "$ref": "common.v1.schema.json#/$defs/literacy_band"
        },
        {
          "type": "null"
        }
      ]
    },
    "edu_band": {
      "anyOf": [
        {
          "$ref": "common.v1.schema.json#/$defs/edu_band"
        },
        {
          "type": "null"
        }
      ]
    },
    "gender": {
      "anyOf": [
        {
          "$ref": "common.v1.schema.json#/$defs/gender"
        },
        {
          "type": "null"
        }
      ]
    },
    "device_familiarity": {
      "anyOf": [
        {
          "$ref": "common.v1.schema.json#/$defs/device_familiarity"
        },
        {
          "type": "null"
        }
      ]
    },
    "played_before": {
      "anyOf": [
        {
          "$ref": "common.v1.schema.json#/$defs/played_before"
        },
        {
          "type": "null"
        }
      ]
    },
    "asr_enabled": {
      "type": "boolean"
    },
    "noise": {
      "type": "object",
      "description": "Noise statistics measured inside the first consented prompt window only.",
      "additionalProperties": false,
      "properties": {
        "noise_floor_dbfs": {
          "type": ["number", "null"],
          "maximum": 0
        },
        "samples": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["noise_floor_dbfs", "samples"]
    },
    "headset": {
      "type": "boolean"
    },
    "a11y": {
      "$ref": "#/$defs/a11y_profile"
    },
    "practice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "practice_struggle": {
          "type": "boolean"
        },
        "skills_passed": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["tap", "hold", "choice", "drag"]
          },
          "uniqueItems": true
        }
      },
      "required": ["practice_struggle", "skills_passed"]
    },
    "battery_arm": {
      "anyOf": [
        {
          "$ref": "common.v1.schema.json#/$defs/battery_arm"
        },
        {
          "type": "null"
        }
      ]
    },
    "slot_form": {
      "anyOf": [
        {
          "$ref": "common.v1.schema.json#/$defs/slot_form"
        },
        {
          "type": "null"
        }
      ]
    },
    "calibration_level": {
      "anyOf": [
        {
          "$ref": "common.v1.schema.json#/$defs/calibration_level"
        },
        {
          "type": "null"
        }
      ]
    },
    "calibration_policy": {
      "$ref": "common.v1.schema.json#/$defs/calibration_policy"
    },
    "linkage_flag": {
      "type": "boolean",
      "description": "True when this session is linked to a pid (pilot/retest modes)."
    },
    "linked_prior_session_token": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{32}$"
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "firmware": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "hardware_sku": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": ["model", "firmware", "hardware_sku"]
    },
    "site_mode": {
      "$ref": "common.v1.schema.json#/$defs/site_mode"
    },
    "mode": {
      "$ref": "common.v1.schema.json#/$defs/session_mode"
    },
    "variant_pack_id": {
      "anyOf": [
        {
          "$ref": "common.v1.schema.json#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "completion": {
      "type": "string",
      "enum": ["in_progress", "complete", "partial", "abandoned"]
    },
    "walkaway_point": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "state": {
          "$ref": "common.v1.schema.json#/$defs/session_state"
        },
        "module_id": {
          "anyOf": [
            {
              "$ref": "common.v1.schema.json#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "trial_id": {
          "anyOf": [
            {
              "$ref": "common.v1.schema.json#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["state", "module_id", "trial_id"]
    }
  },
  "required": [
    "schema_version",
    "session_id",
    "language",
    "age_band",
    "literacy_band",
    "edu_band",
    "gender",
    "device_familiarity",
    "played_before",
    "asr_enabled",
    "noise",
    "headset",
    "a11y",
    "practice",
    "battery_arm",
    "slot_form",
    "calibration_level",
    "calibration_policy",
    "linkage_flag",
    "linked_prior_session_token",
    "device",
    "site_mode",
    "mode",
    "variant_pack_id",
    "completion",
    "walkaway_point"
  ],
  "$defs": {
    "a11y_profile": {
      "type": "object",
      "title": "A11yProfile",
      "additionalProperties": false,
      "properties": {
        "slow_pace": {
          "type": "boolean",
          "description": "Slower-pace choice; maps to L1 and is flagged (KSK-06)."
        },
        "volume_boost": {
          "type": "boolean"
        },
        "headset": {
          "type": "boolean"
        },
        "pictogram_storyboard": {
          "type": "boolean"
        },
        "hold_threshold_ms": {
          "type": ["number", "null"],
          "minimum": 0
        }
      },
      "required": [
        "slow_pace",
        "volume_boost",
        "headset",
        "pictogram_storyboard",
        "hold_threshold_ms"
      ]
    }
  }
}
