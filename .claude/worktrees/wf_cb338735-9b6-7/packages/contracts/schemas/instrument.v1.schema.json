{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shriii.local/contracts/instrument.v1.schema.json",
  "title": "Instrument",
  "description": "content/instruments/*.yaml: criterion instrument registry entry (CRT-02/03/04). Copyrighted item wording is never committed; items carry IDs plus a placeholder and an item_text_source.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "$ref": "common.v1.schema.json#/$defs/minor_schema_version"
    },
    "instrument_id": {
      "$ref": "common.v1.schema.json#/$defs/identifier"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "short_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "version": {
      "$ref": "common.v1.schema.json#/$defs/semver"
    },
    "kind": {
      "type": "string",
      "enum": ["questionnaire", "single_item", "performance", "rating"]
    },
    "citation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "constructs_measured": {
      "type": "array",
      "items": {
        "$ref": "common.v1.schema.json#/$defs/identifier"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "licensing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "holder": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "licence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "permission_status": {
          "type": "string",
          "enum": ["not_requested", "requested", "granted", "denied", "not_required"]
        },
        "permission_document": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 256
        },
        "allowed_use": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "expiry": {
          "type": ["string", "null"],
          "format": "date"
        },
        "commercial_use": {
          "type": "boolean"
        },
        "notes": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": [
        "holder",
        "licence",
        "permission_status",
        "permission_document",
        "allowed_use",
        "expiry",
        "commercial_use",
        "notes"
      ]
    },
    "administration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modes": {
          "type": "array",
          "items": {
            "$ref": "common.v1.schema.json#/$defs/administration_mode"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "audio_assisted": {
          "type": "boolean"
        },
        "estimated_minutes": {
          "type": "number",
          "minimum": 0
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["X", "A", "B", "C", "performance", "teamwork", "retest_short"]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "public_kiosk_allowed": {
          "const": false
        },
        "instructions_key": {
          "$ref": "common.v1.schema.json#/$defs/identifier"
        }
      },
      "required": [
        "modes",
        "audio_assisted",
        "estimated_minutes",
        "blocks",
        "public_kiosk_allowed",
        "instructions_key"
      ]
    },
    "response_scale": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["likert", "numeric", "binary", "performance", "pictorial_likert"]
        },
        "min": {
          "type": ["number", "null"]
        },
        "max": {
          "type": ["number", "null"]
        },
        "anchors": {
          "type": "array",
          "items": {
            "type": "object",
            "title": "ResponseAnchor",
            "additionalProperties": false,
            "properties": {
              "value": {
                "type": "number"
              },
              "label_key": {
                "$ref": "common.v1.schema.json#/$defs/identifier"
              },
              "pictogram_id": {
                "anyOf": [
                  {
                    "$ref": "common.v1.schema.json#/$defs/identifier"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": ["value", "label_key", "pictogram_id"]
          }
        },
        "reverse_formula": {
          "anyOf": [
            {
              "const": "min_plus_max_minus_x"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["type", "min", "max", "anchors", "reverse_formula"]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "title": "InstrumentItem",
        "additionalProperties": false,
        "properties": {
          "item_id": {
            "$ref": "common.v1.schema.json#/$defs/identifier"
          },
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "item_text": {
            "const": "[licensed item text — load from licensed source]",
            "description": "Placeholder; real wording is loaded at administration time from the licensed source file."
          },
          "item_text_source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["licensed_source", "in_house_draft", "performance_task"]
              },
              "reference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "required": ["kind", "reference"]
          },
          "subscales": {
            "type": "array",
            "items": {
              "$ref": "common.v1.schema.json#/$defs/identifier"
            },
            "uniqueItems": true
          },
          "reverse_keyed": {
            "type": "boolean"
          },
          "attention_check": {
            "type": "boolean"
          },
          "block": {
            "type": ["string", "null"],
            "enum": ["X", "A", "B", "C", "performance", "teamwork", "retest_short", null]
          },
          "measures": {
            "type": ["array", "null"],
            "items": {
              "$ref": "common.v1.schema.json#/$defs/identifier"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "item_id",
          "number",
          "item_text",
          "item_text_source",
          "subscales",
          "reverse_keyed",
          "attention_check"
        ]
      },
      "minItems": 1
    },
    "subscales": {
      "type": "array",
      "items": {
        "type": "object",
        "title": "InstrumentScale",
        "additionalProperties": false,
        "properties": {
          "scale_id": {
            "$ref": "common.v1.schema.json#/$defs/identifier"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "common.v1.schema.json#/$defs/identifier"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "score_type": {
            "type": "string",
            "enum": ["mean", "sum", "count", "time_s", "proportion"]
          },
          "min_answered_prop": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "parent": {
            "anyOf": [
              {
                "$ref": "common.v1.schema.json#/$defs/identifier"
              },
              {
                "type": "null"
              }
            ]
          },
          "higher_means": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "scale_id",
          "name",
          "items",
          "score_type",
          "min_answered_prop",
          "parent",
          "higher_means"
        ]
      },
      "minItems": 1
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key_version": {
          "$ref": "common.v1.schema.json#/$defs/semver"
        },
        "prorate_min_prop": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "attention_check_fail_flag": {
          "anyOf": [
            {
              "$ref": "common.v1.schema.json#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": ["key_version", "prorate_min_prop", "attention_check_fail_flag", "notes"]
    },
    "language_versions": {
      "type": "array",
      "items": {
        "type": "object",
        "title": "InstrumentLanguageVersion",
        "additionalProperties": false,
        "properties": {
          "language": {
            "$ref": "common.v1.schema.json#/$defs/language_tag"
          },
          "itc_state": {
            "$ref": "common.v1.schema.json#/$defs/itc_state"
          },
          "approved": {
            "type": "boolean"
          },
          "translation_permission": {
            "type": "string",
            "enum": ["not_requested", "requested", "granted", "denied", "not_required"]
          }
        },
        "required": ["language", "itc_state", "approved", "translation_permission"]
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "instrument_id",
    "name",
    "short_name",
    "version",
    "kind",
    "citation",
    "constructs_measured",
    "licensing",
    "administration",
    "response_scale",
    "items",
    "subscales",
    "scoring",
    "language_versions"
  ]
}
