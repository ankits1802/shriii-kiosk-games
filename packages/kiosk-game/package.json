{
  "name": "@shriii/kiosk-game",
  "version": "0.1.0",
  "private": true,
  "description": "SHRIII kiosk game library: engine, onboarding, episodes (Pathway A), micro-games (Pathway B), report, art kit, audio engine, logger SDK, outbox",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./core/contracts": {
      "types": "./src/core/contracts.ts",
      "default": "./src/core/contracts.ts"
    },
    "./art": {
      "types": "./src/art/index.ts",
      "default": "./src/art/index.ts"
    },
    "./audio": {
      "types": "./src/audio/index.ts",
      "default": "./src/audio/index.ts"
    },
    "./voice": {
      "types": "./src/voice/index.ts",
      "default": "./src/voice/index.ts"
    },
    "./onboarding": {
      "types": "./src/onboarding/index.ts",
      "default": "./src/onboarding/index.ts"
    },
    "./report": {
      "types": "./src/report/index.ts",
      "default": "./src/report/index.ts"
    },
    "./attract": {
      "types": "./src/attract/index.ts",
      "default": "./src/attract/index.ts"
    },
    "./onboarding/harness": {
      "types": "./src/onboarding/harness/devServices.ts",
      "default": "./src/onboarding/harness/devServices.ts"
    }
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "gallery": "vite --config src/art/gallery/dev/vite.config.ts",
    "gallery:build": "vite build --config src/art/gallery/dev/vite.config.ts",
    "voice:catalogue": "node src/voice/catalogue/build-catalogue.ts",
    "report:rules": "node src/report/rules/build-rules.ts"
  },
  "dependencies": {
    "@shriii/contracts": "workspace:*",
    "@xstate/react": "6.1.0",
    "dexie": "4.4.6",
    "gsap": "3.15.0",
    "pixi-filters": "6.1.5",
    "pixi.js": "8.22.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "xstate": "5.33.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "^6.2.6",
    "fast-check": "4.10.2",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
