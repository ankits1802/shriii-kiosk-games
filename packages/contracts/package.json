{
  "name": "@shriii/contracts",
  "version": "1.0.0",
  "private": true,
  "description": "Canonical JSON Schema 2020-12 contracts for SHRIII, with generated TypeScript types and Ajv standalone validators",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./validators/*": {
      "types": "./src/generated/validators/*.d.ts",
      "default": "./src/generated/validators/*.js"
    },
    "./schemas/*": "./schemas/*",
    "./fixtures/*": "./fixtures/*"
  },
  "files": [
    "schemas",
    "src",
    "fixtures"
  ],
  "scripts": {
    "generate": "node scripts/generate.ts",
    "build": "node scripts/generate.ts --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "biome check ."
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
