{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shriii.local/contracts/criterion-scale-score.v1.schema.json",
  "title": "CriterionScaleScore",
  "description": "Layer 3 criterion scale score computed from responses and a versioned scoring key (CRT-04). References algorithm version, source records and data snapshot.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "$ref": "common.v1.schema.json#/$defs/minor_schema_version"
    },
    "score_id": {
      "$ref": "common.v1.schema.json#/$defs/uuid"
    },
    "pid": {
      "$ref": "common.v1.schema.json#/$defs/pid"
    },
    "study_id": {
      "$ref": "common.v1.schema.json#/$defs/identifier"
    },
    "wave": {
      "type": "integer",
      "minimum": 1
    },
    "occasion_id": {
      "$ref": "common.v1.schema.json#/$defs/identifier"
    },
    "instrument_id": {
      "$ref": "common.v1.schema.json#/$defs/identifier"
    },
    "instrument_version": {
      "$ref": "common.v1.schema.json#/$defs/semver"
    },
    "scale_id": {
      "$ref": "common.v1.schema.json#/$defs/identifier"
    },
    "score": {
      "type": ["number", "null"]
    },
    "score_type": {
      "type": "string",
      "enum": ["mean", "sum", "count", "time_s", "proportion"]
    },
    "n_answered": {
      "type": "integer",
      "minimum": 0
    },
    "n_items": {
      "type": "integer",
      "minimum": 1
    },
    "key_version": {
      "$ref": "common.v1.schema.json#/$defs/semver"
    },
    "algorithm_version": {
      "$ref": "common.v1.schema.json#/$defs/semver"
    },
    "prorated": {
      "type": "boolean"
    },
    "planned_missing": {
      "type": "boolean"
    },
    "na_reason": {
      "type": ["string", "null"],
      "enum": [
        "insufficient_items",
        "planned_missing",
        "criterion_careless",
        "not_administered",
        null
      ]
    },
    "flags": {
      "type": "array",
      "items": {
        "$ref": "common.v1.schema.json#/$defs/identifier"
      },
      "uniqueItems": true
    },
    "source_response_ids": {
      "type": "array",
      "items": {
        "$ref": "common.v1.schema.json#/$defs/uuid"
      },
      "uniqueItems": true
    },
    "scoring_run_id": {
      "$ref": "common.v1.schema.json#/$defs/uuid"
    },
    "data_snapshot_id": {
      "anyOf": [
        {
          "$ref": "common.v1.schema.json#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "computed_at": {
      "$ref": "common.v1.schema.json#/$defs/date_time"
    }
  },
  "required": [
    "schema_version",
    "score_id",
    "pid",
    "study_id",
    "wave",
    "occasion_id",
    "instrument_id",
    "instrument_version",
    "scale_id",
    "score",
    "score_type",
    "n_answered",
    "n_items",
    "key_version",
    "algorithm_version",
    "prorated",
    "planned_missing",
    "na_reason",
    "flags",
    "source_response_ids",
    "scoring_run_id",
    "data_snapshot_id",
    "computed_at"
  ]
}
