{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shriii.local/contracts/voice-line-catalogue.v1.schema.json",
  "title": "VoiceLineCatalogue",
  "description": "content/i18n/lines.yaml: catalogue of pre-recorded voice-line IDs. reference_text (en-IN) is used only for recording scripts; there is no runtime TTS.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "$ref": "common.v1.schema.json#/$defs/minor_schema_version"
    },
    "catalogue_version": {
      "$ref": "common.v1.schema.json#/$defs/semver"
    },
    "reference_language": {
      "$ref": "common.v1.schema.json#/$defs/language_tag"
    },
    "languages": {
      "type": "array",
      "items": {
        "$ref": "common.v1.schema.json#/$defs/language_tag"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "title": "VoiceLine",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.v1.schema.json#/$defs/identifier"
          },
          "category": {
            "type": "string",
            "enum": [
              "attract",
              "onboarding",
              "consent",
              "bands",
              "practice",
              "guide",
              "feedback",
              "walkaway",
              "report",
              "survey",
              "optin",
              "system",
              "criterion"
            ]
          },
          "module_id": {
            "anyOf": [
              {
                "$ref": "common.v1.schema.json#/$defs/identifier"
              },
              {
                "type": "null"
              }
            ]
          },
          "speaker_role": {
            "type": "string",
            "enum": ["guide", "narrator", "customer", "assistant", "partner", "inspector", "system"]
          },
          "context": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "reference_text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "target_duration_ms": {
            "type": "integer",
            "minimum": 200,
            "maximum": 60000
          },
          "tone": {
            "type": "string",
            "enum": [
              "warm",
              "neutral",
              "encouraging",
              "calm",
              "firm",
              "hostile",
              "playful",
              "urgent"
            ]
          },
          "voice_forbidden": {
            "type": "boolean"
          },
          "recording": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "title": "LineRecordingStatus",
              "additionalProperties": false,
              "properties": {
                "status": {
                  "type": "string",
                  "enum": ["not_scripted", "scripted", "recorded", "audio_qc", "approved"]
                },
                "itc_state": {
                  "$ref": "common.v1.schema.json#/$defs/itc_state"
                }
              },
              "required": ["status", "itc_state"]
            }
          }
        },
        "required": [
          "id",
          "category",
          "module_id",
          "speaker_role",
          "context",
          "reference_text",
          "target_duration_ms",
          "tone",
          "voice_forbidden",
          "recording"
        ]
      },
      "minItems": 1
    }
  },
  "required": ["schema_version", "catalogue_version", "reference_language", "languages", "lines"]
}
