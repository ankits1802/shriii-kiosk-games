# SHRIII kiosk gadget for the single reference SKU (amd64, UEFI + Secure Boot + TPM 2.0), Ubuntu Core 24.
# Rendered to gadget.yaml by infra/kiosk-image/scripts/render-gadget.sh (snap ids from the brand store).
# Volume layout follows canonical/pc-gadget (branch 24) without the legacy-BIOS structures: the kiosk SKU
# boots UEFI only, which Secure Boot and TPM-backed FDE require anyway (KSK-09).
volumes:
  pc:
    schema: gpt
    bootloader: grub
    structure:
      - name: ubuntu-seed
        role: system-seed
        filesystem: vfat
        type: C12A7328-F81F-11D2-BA4B-00A0C93EC93B
        size: 1200M
        update:
          edition: 3
        content:
          - source: grubx64.efi
            target: EFI/ubuntu/grubx64.efi
          - source: shim.efi.signed
            target: EFI/ubuntu/shimx64.efi
          - source: boot.csv
            target: EFI/ubuntu/bootx64.csv
          - source: fb.efi
            target: EFI/boot/fbx64.efi
          - source: shim.efi.signed
            target: EFI/boot/bootx64.efi
      - name: ubuntu-boot
        role: system-boot
        filesystem: ext4
        type: 0FC63DAF-8483-4772-8E79-3D69D8477DE4
        size: 750M
        update:
          edition: 1
        content:
          - source: grubx64.efi
            target: EFI/boot/grubx64.efi
      - name: ubuntu-save
        role: system-save
        filesystem: ext4
        type: 0FC63DAF-8483-4772-8E79-3D69D8477DE4
        min-size: 16M
        size: 32M
      - name: ubuntu-data
        role: system-data
        filesystem: ext4
        type: 0FC63DAF-8483-4772-8E79-3D69D8477DE4
        size: 8G

# Kernel parameters that snapd may append at run time (system.kernel.cmdline-append). Enrolment appends the
# USB mass-storage blacklist once the bench system user has been imported and removed (see README).
kernel-cmdline:
  allow:
    - modprobe.blacklist=usb_storage,uas

defaults:
  # ---- snapd / system options (KSK-09 lockdown)
  system:
    service:
      console-conf:
        disable: true          # no first-boot console wizard, no TTY login prompt
      ssh:
        disable: false         # bench provisioning only; enrolment sets service.ssh.disable=true
    watchdog:
      runtime-timeout: 30s     # hardware watchdog: a hung kernel/systemd reboots back to attract
      shutdown-timeout: 10m
    refresh:
      # Refreshes happen only in the overnight window when no session can be running; *which* revisions are
      # allowed is pinned by the shriii-wave-freeze validation set in the model (KSK-11).
      timer: "02:00-04:30"
      retain: 2
      metered: hold
    system:
      timezone: Asia/Kolkata
      power-key-action: ignore # the power button cannot be used to escape or reboot mid-session
      ctrl-alt-del-action: none
    journal:
      persistent: true

  # ---- Ubuntu Frame: hide the cursor, no idle blanking (the attract loop owns the screen)
  ${FRAME_SNAP_ID}:
    daemon: true
    config: |
      cursor=null
      idle-timeout=0

  # ---- the kiosk app: pinned root CA and the egress allow-list defaults
  ${KIOSK_SNAP_ID}:
    ca:
      root-fingerprint: "${CA_ROOT_FINGERPRINT}"
    netguard:
      enforce: true
      store-proxy: "${SNAP_STORE_PROXY}"

connections:
  - plug: ${KIOSK_SNAP_ID}:wayland
    slot: ${FRAME_SNAP_ID}:wayland
  - plug: ${KIOSK_SNAP_ID}:audio-playback
    slot: ${PIPEWIRE_SNAP_ID}:audio-playback
  - plug: ${KIOSK_SNAP_ID}:escpos-printer
    slot: ${GADGET_SNAP_ID}:escpos-printer
  - plug: ${KIOSK_SNAP_ID}:opengl
  - plug: ${KIOSK_SNAP_ID}:browser-support
  - plug: ${KIOSK_SNAP_ID}:hardware-observe
  - plug: ${KIOSK_SNAP_ID}:firewall-control
  - plug: ${KIOSK_SNAP_ID}:snapd-control
