# Web app (Next.js standalone) - DEVELOPMENT DEFAULTS ONLY.
# The browser calls the API same-origin through the app's /api/v1 rewrites; server-side calls and the rewrites
# target the api service over the compose network (API_PROXY_TARGET is also a build argument, see compose).
API_PROXY_TARGET=http://api:8000
API_BASE_URL=http://api:8000
NODE_ENV=production
