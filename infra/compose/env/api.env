# Backend (api, worker, migrate) - DEVELOPMENT DEFAULTS ONLY. Put overrides in env/local.env (git-ignored).
ENV=dev
LOG_LEVEL=INFO
LOG_JSON=true
DATABASE_URL=postgresql+psycopg://shriii:shriii-dev@postgres:5432/shriii
# Separate identity-vault database and connection (PRV-04); created by postgres-init/10-identity-db.sql.
IDENTITY_DATABASE_URL=postgresql+psycopg://shriii:shriii-dev@postgres:5432/shriii_identity
AUTH_MODE=dev
DEV_JWT_SECRET=compose-dev-only-not-a-secret
API_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
PUBLIC_BASE_URL=http://localhost:3000
DATA_DIR=/var/lib/shriii
WORKER_POLL_INTERVAL_S=1.0
OTEL_ENABLED=false
