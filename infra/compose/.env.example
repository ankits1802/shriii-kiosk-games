# Copy to infra/compose/.env (read by Docker Compose) and/or to the repository-root .env (read by the API and
# tooling when run from the root). Never commit .env. Development defaults only.

# --- PostgreSQL (infra/compose/docker-compose.yml) ---
POSTGRES_DB=shriii
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev
POSTGRES_PORT=5432
ADMINER_PORT=8080

# --- API (backend/api, FastAPI + SQLAlchemy 2 + psycopg 3) ---
DATABASE_URL=postgresql+psycopg://dev:dev@localhost:5432/shriii
# Local signed-JWT dev login (OIDC provider configured in non-dev environments).
AUTH_MODE=dev
DEV_JWT_SECRET=change-me-dev-only
API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Kiosk (frontend/apps/kiosk, Vite). VITE_* values are compiled into the bundle. ---
VITE_API_BASE_URL=http://localhost:8000
# Dev-only placeholder voice (Web Speech) with a "DEV VOICE" banner; ignored by production builds.
VITE_DEV_VOICE_PLACEHOLDER=false
VITE_DEV_OVERLAY=false

# --- Python tooling ---
# Point at a schema copy when running outside the monorepo:
# SHRIII_REPO_ROOT=
# SHRIII_SCHEMAS_DIR=
