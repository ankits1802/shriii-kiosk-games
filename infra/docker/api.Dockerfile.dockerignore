# Build context filter for infra/docker/api.Dockerfile (BuildKit reads <Dockerfile>.dockerignore).
# Allow-list: only what the backend image needs.
*
!pyproject.toml
!uv.lock
!backend/api/
!contracts/python/
!stats/scoring/
!stats/validation/
!stats/simulator/
!stats/rbridge/
!contracts/schemas/
!stats/measurement-model/
!content/
!infra/docker/healthcheck.py
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.venv
**/tests/
**/.data
