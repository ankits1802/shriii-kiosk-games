{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shriii.local/contracts/game-trial-spec.v1.schema.json",
  "title": "GameTrialSpec",
  "description": "One scheduled trial produced by the seeded scheduler (ENG-05, ENG-09). voice_vocabulary must be a subset of vocabulary.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "$ref": "common.v1.schema.json#/$defs/minor_schema_version"
    },
    "trial_id": {
      "$ref": "common.v1.schema.json#/$defs/identifier"
    },
    "module_id": {
      "$ref": "common.v1.schema.json#/$defs/identifier"
    },
    "episode_id": {
      "anyOf": [
        {
          "$ref": "common.v1.schema.json#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "block_id": {
      "$ref": "common.v1.schema.json#/$defs/identifier"
    },
    "trial_index": {
      "type": "integer",
      "minimum": 0
    },
    "trial_type": {
      "$ref": "common.v1.schema.json#/$defs/identifier"
    },
    "phase": {
      "$ref": "common.v1.schema.json#/$defs/phase"
    },
    "condition_id": {
      "$ref": "common.v1.schema.json#/$defs/identifier"
    },
    "calibration_level": {
      "$ref": "common.v1.schema.json#/$defs/calibration_level"
    },
    "response_window_ms": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "stimulus_id": {
      "anyOf": [
        {
          "$ref": "common.v1.schema.json#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "vocabulary": {
      "type": "array",
      "items": {
        "$ref": "common.v1.schema.json#/$defs/closed_code"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "voice_vocabulary": {
      "type": "array",
      "items": {
        "$ref": "common.v1.schema.json#/$defs/closed_code"
      },
      "uniqueItems": true
    },
    "audio_keys": {
      "type": "array",
      "items": {
        "$ref": "common.v1.schema.json#/$defs/identifier"
      },
      "uniqueItems": true
    },
    "private_report": {
      "type": "boolean"
    },
    "anchor_trial": {
      "type": "boolean"
    },
    "form_id": {
      "$ref": "common.v1.schema.json#/$defs/identifier"
    },
    "probe_group_id": {
      "anyOf": [
        {
          "$ref": "common.v1.schema.json#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "scorable": {
      "type": "boolean"
    },
    "expected_response": {
      "anyOf": [
        {
          "$ref": "common.v1.schema.json#/$defs/closed_code"
        },
        {
          "type": "null"
        }
      ]
    },
    "latency_anchor": {
      "$ref": "common.v1.schema.json#/$defs/latency_anchor"
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stimulus_duration_ms": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "isi_ms": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "jitter_ms": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      },
      "required": ["stimulus_duration_ms", "isi_ms", "jitter_ms"]
    },
    "params": {
      "type": "object",
      "description": "Module-specific closed parameters (e.g. explosion point, tone level, map id)."
    }
  },
  "required": [
    "schema_version",
    "trial_id",
    "module_id",
    "episode_id",
    "block_id",
    "trial_index",
    "trial_type",
    "phase",
    "condition_id",
    "calibration_level",
    "response_window_ms",
    "stimulus_id",
    "vocabulary",
    "voice_vocabulary",
    "audio_keys",
    "private_report",
    "anchor_trial",
    "form_id",
    "probe_group_id",
    "scorable",
    "expected_response",
    "latency_anchor",
    "timing",
    "params"
  ]
}
