{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shriii.local/contracts/gates.v1.schema.json",
  "title": "Gates",
  "description": "scoring/gates.yaml: battery release gate and trait gate rules (plan section 7.7). Thresholds change only by amendment.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "$ref": "common.v1.schema.json#/$defs/minor_schema_version"
    },
    "gates_id": {
      "$ref": "common.v1.schema.json#/$defs/identifier"
    },
    "version": {
      "$ref": "common.v1.schema.json#/$defs/semver"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "frozen", "amended"]
    },
    "frozen_at": {
      "anyOf": [
        {
          "$ref": "common.v1.schema.json#/$defs/date_time"
        },
        {
          "type": "null"
        }
      ]
    },
    "sha256": {
      "anyOf": [
        {
          "$ref": "common.v1.schema.json#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "governance_record": {
      "anyOf": [
        {
          "$ref": "common.v1.schema.json#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "fail_closed": {
      "const": true
    },
    "battery_gate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["language", "pathway", "site_mode"]
          },
          "minItems": 3,
          "uniqueItems": true
        },
        "min_language_groups": {
          "type": "integer",
          "minimum": 2
        },
        "tier1_reliability_share_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "count_withheld_as_fail": {
          "type": "boolean"
        },
        "require_criterion_invariance": {
          "type": "boolean"
        },
        "require_no_unresolved_large_dif": {
          "type": "boolean"
        },
        "differential_exclusion_max_pp": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "open_public_requires_mode_equivalence": {
          "type": "boolean"
        },
        "signoff_roles": {
          "type": "array",
          "items": {
            "$ref": "common.v1.schema.json#/$defs/identifier"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "closed_behaviour": {
          "const": "thank_you_only"
        }
      },
      "required": [
        "scope",
        "min_language_groups",
        "tier1_reliability_share_min",
        "count_withheld_as_fail",
        "require_criterion_invariance",
        "require_no_unresolved_large_dif",
        "differential_exclusion_max_pp",
        "open_public_requires_mode_equivalence",
        "signoff_roles",
        "closed_behaviour"
      ]
    },
    "trait_gate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "retest": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "statistic": {
              "const": "icc_a1"
            },
            "point_min": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "lower_bound_min": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "ci_level": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "pooled_language_point_min": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "min_pairs_per_cell": {
              "type": "integer",
              "minimum": 1
            },
            "pearson_allowed": {
              "const": false
            }
          },
          "required": [
            "statistic",
            "point_min",
            "lower_bound_min",
            "ci_level",
            "pooled_language_point_min",
            "min_pairs_per_cell",
            "pearson_allowed"
          ]
        },
        "reliability": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "point_min": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "lower_bound_min": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "ci_level": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": ["point_min", "lower_bound_min", "ci_level"]
        },
        "convergent": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "observed_only": {
              "const": true
            },
            "lower_bound_gt": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "correction": {
              "type": "string",
              "enum": ["holm", "bh_fdr"]
            },
            "require_correct_sign": {
              "type": "boolean"
            },
            "require_pattern_own_gt_discriminant": {
              "type": "boolean"
            },
            "upper_bound": {
              "type": "null"
            }
          },
          "required": [
            "observed_only",
            "lower_bound_gt",
            "correction",
            "require_correct_sign",
            "require_pattern_own_gt_discriminant",
            "upper_bound"
          ]
        },
        "invariance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "required_groupings": {
              "type": "array",
              "items": {
                "$ref": "common.v1.schema.json#/$defs/identifier"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "max_freed_parameter_share": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "small_group_n": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": ["required_groupings", "max_freed_parameter_share", "small_group_n"]
        },
        "norms": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "required": {
              "type": "string",
              "enum": ["provisional_or_final", "final"]
            },
            "sem_rule": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ci_level": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "max_band_boundaries_overlapped": {
                  "type": "integer",
                  "minimum": 0
                },
                "min_band_width_sem": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": ["ci_level", "max_band_boundaries_overlapped", "min_band_width_sem"]
            }
          },
          "required": ["required", "sem_rule"]
        },
        "min_named_signers": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "retest",
        "reliability",
        "convergent",
        "invariance",
        "norms",
        "min_named_signers"
      ]
    },
    "caps": {
      "type": "array",
      "items": {
        "type": "object",
        "title": "StatusCap",
        "additionalProperties": false,
        "properties": {
          "construct": {
            "$ref": "common.v1.schema.json#/$defs/construct_id"
          },
          "max_status": {
            "$ref": "common.v1.schema.json#/$defs/trait_gate_status"
          },
          "stricter_flag": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": ["construct", "max_status", "stricter_flag", "reason"]
      }
    },
    "permanent_withhold": {
      "type": "array",
      "items": {
        "type": "object",
        "title": "PermanentWithhold",
        "additionalProperties": false,
        "properties": {
          "construct": {
            "$ref": "common.v1.schema.json#/$defs/construct_id"
          },
          "pathway": {
            "$ref": "common.v1.schema.json#/$defs/pathway"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": ["construct", "pathway", "reason"]
      }
    },
    "group_only_indicators": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z_]+\\.[a-z0-9_]+$",
        "description": "Indicator id: <construct_id>.<name>."
      },
      "uniqueItems": true
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "disattenuated_feeds_gates": {
          "const": false
        },
        "regressions_reclose_gates": {
          "const": true
        },
        "evaluate_only_can_promote": {
          "const": false
        },
        "thresholds_change_by_amendment_only": {
          "const": true
        }
      },
      "required": [
        "disattenuated_feeds_gates",
        "regressions_reclose_gates",
        "evaluate_only_can_promote",
        "thresholds_change_by_amendment_only"
      ]
    },
    "display_rule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "battery_gate": {
          "const": "open"
        },
        "trait_status_in": {
          "type": "array",
          "items": {
            "$ref": "common.v1.schema.json#/$defs/trait_gate_status"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "session_valid_for_report": {
          "const": true
        },
        "exclude_not_enough_to_say": {
          "const": true
        },
        "release_pack_valid_and_unexpired": {
          "const": true
        },
        "report_mode": {
          "const": "player_report"
        }
      },
      "required": [
        "battery_gate",
        "trait_status_in",
        "session_valid_for_report",
        "exclude_not_enough_to_say",
        "release_pack_valid_and_unexpired",
        "report_mode"
      ]
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "band_count": {
          "type": "integer",
          "minimum": 2
        },
        "min_traits_shown": {
          "type": "integer",
          "minimum": 0
        },
        "max_traits_shown": {
          "type": "integer",
          "minimum": 1
        },
        "disclaimer_required": {
          "const": true
        }
      },
      "required": ["band_count", "min_traits_shown", "max_traits_shown", "disclaimer_required"]
    },
    "release_pack": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_expiry_days": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["default_expiry_days"]
    },
    "reliability_methods": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "raw": {
          "type": "string",
          "enum": [
            "split_half_permutation",
            "model_based",
            "model_based_slope",
            "composite_omega",
            "not_computed"
          ]
        },
        "difference_slope": {
          "type": "string",
          "enum": [
            "split_half_permutation",
            "model_based",
            "model_based_slope",
            "composite_omega",
            "not_computed"
          ]
        },
        "model_parameter": {
          "type": "string",
          "enum": [
            "split_half_permutation",
            "model_based",
            "model_based_slope",
            "composite_omega",
            "not_computed"
          ]
        },
        "composite": {
          "type": "string",
          "enum": [
            "split_half_permutation",
            "model_based",
            "model_based_slope",
            "composite_omega",
            "not_computed"
          ]
        },
        "group_only": {
          "type": "string",
          "enum": [
            "split_half_permutation",
            "model_based",
            "model_based_slope",
            "composite_omega",
            "not_computed"
          ]
        },
        "single_event_unscorable": {
          "type": "string",
          "enum": [
            "split_half_permutation",
            "model_based",
            "model_based_slope",
            "composite_omega",
            "not_computed"
          ]
        }
      },
      "required": [
        "raw",
        "difference_slope",
        "model_parameter",
        "composite",
        "group_only",
        "single_event_unscorable"
      ]
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "floor_ceiling_flag_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "criterion_omega_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "practice_effect_d_flag": {
          "type": "number",
          "minimum": 0
        },
        "fairness_cell_min_n": {
          "type": "integer",
          "minimum": 1
        },
        "split_half_permutations": {
          "type": "integer",
          "minimum": 100
        }
      },
      "required": [
        "floor_ceiling_flag_share",
        "criterion_omega_min",
        "practice_effect_d_flag",
        "fairness_cell_min_n",
        "split_half_permutations"
      ]
    },
    "asr_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_accuracy": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "snr_db": {
          "type": "number"
        },
        "max_group_gap_pp": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "min_heldout_speakers": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["min_accuracy", "snr_db", "max_group_gap_pp", "min_heldout_speakers"]
    },
    "stage_exits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "think_aloud": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_reading_dependent_screens": {
              "type": "integer",
              "minimum": 0
            },
            "max_digit_dependent_decisions": {
              "type": "integer",
              "minimum": 0
            },
            "max_unresolved_misunderstood_share": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "onboarding_median_max_s": {
              "type": "number",
              "minimum": 0
            },
            "report_comprehension_min": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "max_reading_dependent_screens",
            "max_digit_dependent_decisions",
            "max_unresolved_misunderstood_share",
            "onboarding_median_max_s",
            "report_comprehension_min"
          ]
        },
        "stage2_allows_drops": {
          "const": false
        }
      },
      "required": ["think_aloud", "stage2_allows_drops"]
    }
  },
  "required": [
    "schema_version",
    "gates_id",
    "version",
    "status",
    "frozen_at",
    "sha256",
    "governance_record",
    "fail_closed",
    "battery_gate",
    "trait_gate",
    "caps",
    "permanent_withhold",
    "group_only_indicators",
    "rules",
    "display_rule",
    "report",
    "release_pack",
    "reliability_methods",
    "quality",
    "asr_policy",
    "stage_exits"
  ]
}
