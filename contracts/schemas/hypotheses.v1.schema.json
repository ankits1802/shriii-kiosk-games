{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shriii.local/contracts/hypotheses.v1.schema.json",
  "title": "Hypotheses",
  "description": "stats/measurement-model/hypotheses.yaml: pre-registration registry (CRT-11). Frozen with gates.yaml before Stage 2 unblinding.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "$ref": "common.v1.schema.json#/$defs/minor_schema_version"
    },
    "registry_id": {
      "$ref": "common.v1.schema.json#/$defs/identifier"
    },
    "version": {
      "$ref": "common.v1.schema.json#/$defs/semver"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "frozen", "amended"]
    },
    "frozen_at": {
      "anyOf": [
        {
          "$ref": "common.v1.schema.json#/$defs/date_time"
        },
        {
          "type": "null"
        }
      ]
    },
    "sha256": {
      "anyOf": [
        {
          "$ref": "common.v1.schema.json#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "governance_record": {
      "anyOf": [
        {
          "$ref": "common.v1.schema.json#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "prereg_id": {
      "anyOf": [
        {
          "$ref": "common.v1.schema.json#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "r0": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ci_level": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "alpha": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "bootstrap_resamples": {
          "type": "integer",
          "minimum": 100
        },
        "permutation_resamples": {
          "type": "integer",
          "minimum": 100
        },
        "correlation": {
          "type": "string",
          "enum": ["pearson", "spearman"]
        },
        "estimates": {
          "const": "observed",
          "description": "Gates and confirmatory tests use observed r only; disattenuated r is secondary."
        }
      },
      "required": [
        "r0",
        "ci_level",
        "alpha",
        "bootstrap_resamples",
        "permutation_resamples",
        "correlation",
        "estimates"
      ]
    },
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "title": "HypothesisFamily",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.v1.schema.json#/$defs/identifier"
          },
          "kind": {
            "type": "string",
            "enum": ["confirmatory", "secondary", "exploratory", "group_level"]
          },
          "correction": {
            "type": "string",
            "enum": ["holm", "bh_fdr", "none"]
          },
          "alpha": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": ["id", "kind", "correction", "alpha", "description"]
      },
      "minItems": 1
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "title": "Hypothesis",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.v1.schema.json#/$defs/identifier"
          },
          "family": {
            "$ref": "common.v1.schema.json#/$defs/identifier"
          },
          "construct": {
            "$ref": "common.v1.schema.json#/$defs/construct_id"
          },
          "pathways": {
            "type": "array",
            "items": {
              "$ref": "common.v1.schema.json#/$defs/pathway"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "type": {
            "type": "string",
            "enum": [
              "convergent_lower_bound",
              "discriminant_pattern",
              "nomological",
              "group_level",
              "retest_stability"
            ]
          },
          "indicators": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z_]+\\.[a-z0-9_]+$",
              "description": "Indicator id: <construct_id>.<name>."
            },
            "uniqueItems": true
          },
          "criterion": {
            "type": ["string", "null"],
            "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)?$",
            "description": "Criterion reference <instrument_id>.<scale_id> (or a bare instrument id for single-score criteria)."
          },
          "convergent_criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)?$",
              "description": "Criterion reference <instrument_id>.<scale_id> (or a bare instrument id for single-score criteria)."
            },
            "uniqueItems": true
          },
          "discriminant_criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)?$",
              "description": "Criterion reference <instrument_id>.<scale_id> (or a bare instrument id for single-score criteria)."
            },
            "uniqueItems": true
          },
          "expected_sign": {
            "type": ["string", "null"],
            "enum": ["positive", "negative", null]
          },
          "r0": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1
          },
          "statistic": {
            "type": "string",
            "enum": [
              "observed_r_lower_bound",
              "r_contrast_cv",
              "icc_a1",
              "tost_group_rate",
              "group_rate_difference"
            ]
          },
          "pooling": {
            "type": "string",
            "enum": [
              "pooled_languages_and_arms_if_invariant",
              "per_language",
              "pooled_if_invariant",
              "per_language_and_pooled"
            ]
          },
          "notes": {
            "type": ["string", "null"],
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "id",
          "family",
          "construct",
          "pathways",
          "type",
          "indicators",
          "criterion",
          "convergent_criteria",
          "discriminant_criteria",
          "expected_sign",
          "r0",
          "statistic",
          "pooling",
          "notes"
        ]
      },
      "minItems": 1
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "completion": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "supervised": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "open_public": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": ["supervised", "open_public"]
        },
        "play_again": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "per": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["language", "arm", "site_mode"]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": ["completion", "play_again", "per"]
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "title": "GateException",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.v1.schema.json#/$defs/identifier"
          },
          "construct": {
            "$ref": "common.v1.schema.json#/$defs/construct_id"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "cap_status": {
            "$ref": "common.v1.schema.json#/$defs/trait_gate_status"
          },
          "lifted_when": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": ["id", "construct", "description", "cap_status", "lifted_when"]
      }
    },
    "research_only_path": {
      "type": "array",
      "items": {
        "type": "object",
        "title": "ResearchOnlyStep",
        "additionalProperties": false,
        "properties": {
          "step": {
            "type": "integer",
            "minimum": 1
          },
          "rule": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": ["step", "rule"]
      },
      "minItems": 1
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "title": "CoverageEntry",
        "additionalProperties": false,
        "properties": {
          "construct": {
            "$ref": "common.v1.schema.json#/$defs/construct_id"
          },
          "A": {
            "type": "string",
            "enum": ["confirmatory", "exploratory", "group_only", "withheld"]
          },
          "B": {
            "type": "string",
            "enum": ["confirmatory", "exploratory", "group_only", "withheld"]
          }
        },
        "required": ["construct", "A", "B"]
      },
      "minItems": 17
    }
  },
  "required": [
    "schema_version",
    "registry_id",
    "version",
    "status",
    "frozen_at",
    "sha256",
    "governance_record",
    "prereg_id",
    "defaults",
    "families",
    "hypotheses",
    "targets",
    "exceptions",
    "research_only_path",
    "coverage"
  ]
}
