{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shriii.local/contracts/consent-artefact.v1.schema.json",
  "title": "ConsentArtefact",
  "description": "Immutable consent record (plan section 6.3). Changes are superseding records. Consent is always by tap; there is no recognised_label field.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "$ref": "common.v1.schema.json#/$defs/minor_schema_version"
    },
    "consent_id": {
      "$ref": "common.v1.schema.json#/$defs/uuid"
    },
    "participant_pid": {
      "anyOf": [
        {
          "$ref": "common.v1.schema.json#/$defs/pid"
        },
        {
          "type": "null"
        }
      ]
    },
    "session_id": {
      "anyOf": [
        {
          "$ref": "common.v1.schema.json#/$defs/uuidv7"
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "$ref": "common.v1.schema.json#/$defs/consent_kind"
    },
    "granted": {
      "type": "boolean"
    },
    "consent_script_id": {
      "$ref": "common.v1.schema.json#/$defs/identifier"
    },
    "script_audio_sha256": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    },
    "language": {
      "$ref": "common.v1.schema.json#/$defs/language_tag"
    },
    "policy_version": {
      "$ref": "common.v1.schema.json#/$defs/semver"
    },
    "protocol_id": {
      "anyOf": [
        {
          "$ref": "common.v1.schema.json#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "input_mode": {
      "const": "tap"
    },
    "presented_at": {
      "$ref": "common.v1.schema.json#/$defs/date_time"
    },
    "decided_at": {
      "$ref": "common.v1.schema.json#/$defs/date_time"
    },
    "kiosk_id": {
      "anyOf": [
        {
          "$ref": "common.v1.schema.json#/$defs/kiosk_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "replay_counts": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "supersedes_id": {
      "anyOf": [
        {
          "$ref": "common.v1.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "consent_id",
    "participant_pid",
    "session_id",
    "kind",
    "granted",
    "consent_script_id",
    "script_audio_sha256",
    "language",
    "policy_version",
    "protocol_id",
    "input_mode",
    "presented_at",
    "decided_at",
    "kiosk_id",
    "replay_counts",
    "supersedes_id"
  ]
}
