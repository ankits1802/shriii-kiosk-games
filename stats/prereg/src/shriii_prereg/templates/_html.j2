{#- HTML macro set (autoescaped). Same macro names and signatures as _md.j2. -#}
{% macro doc_start(doc) -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ doc.meta.short_title }}</title>
<meta name="generator" content="{{ doc.meta.generator }} {{ doc.meta.generator_version }}">
<meta name="shriii-prereg-status" content="{{ doc.meta.status }}">
{% for f in doc.inputs %}
<meta name="shriii-input-sha256" data-role="{{ f.role }}" data-path="{{ f.path }}" content="{{ f.sha256 }}">
{% endfor %}
<style>
:root { --bg:#ffffff; --fg:#1d232b; --muted:#5b6672; --line:#d9dee4; --head:#f3f5f7; --warn-bg:#fff6e0; --warn-line:#d79a00; --rev-bg:#eef3ff; --rev-line:#3b6fd8; }
@media (prefers-color-scheme: dark) { :root { --bg:#14181d; --fg:#e6e9ed; --muted:#9aa5b1; --line:#2e3640; --head:#1c2229; --warn-bg:#2d2512; --warn-line:#d79a00; --rev-bg:#17213a; --rev-line:#6f95e6; } }
body { background:var(--bg); color:var(--fg); font:15px/1.55 system-ui, -apple-system, "Segoe UI", sans-serif; margin:0 auto; max-width:1100px; padding:24px 16px 64px; }
h1 { font-size:1.6rem; line-height:1.25; } h2 { margin-top:2.2rem; border-bottom:1px solid var(--line); padding-bottom:.3rem; } h3 { margin-top:1.6rem; }
table { border-collapse:collapse; width:100%; margin:.6rem 0 1.2rem; font-size:.86rem; display:block; overflow-x:auto; }
th, td { border:1px solid var(--line); padding:4px 7px; text-align:left; vertical-align:top; }
th { background:var(--head); }
code { font-family:ui-monospace, Consolas, monospace; font-size:.85em; overflow-wrap:anywhere; }
.callout { border-left:4px solid var(--warn-line); background:var(--warn-bg); padding:8px 12px; margin:1rem 0; }
.review { border-left:4px solid var(--rev-line); background:var(--rev-bg); padding:8px 12px; margin:1rem 0; }
footer { margin-top:3rem; color:var(--muted); font-size:.82rem; border-top:1px solid var(--line); padding-top:.8rem; overflow-wrap:anywhere; }
</style>
</head>
<body>
<!-- shriii-prereg-inputs: {{ inputs_json }} -->
<main>
{% endmacro %}

{% macro doc_end(doc) -%}
</main>
<footer>
Generated by {{ doc.meta.generator }} {{ doc.meta.generator_version }} at {{ doc.meta.generated_at }}. Inputs:
{% for f in doc.inputs %}<code>{{ f.path }}</code> sha256 <code>{{ f.sha256 }}</code>{% if not loop.last %}; {% endif %}{% endfor %}.
</footer>
</body>
</html>
{% endmacro %}

{% macro h(level, text) -%}
<h{{ level }}>{{ text }}</h{{ level }}>
{% endmacro %}

{% macro p(text) -%}
<p>{{ text }}</p>
{% endmacro %}

{% macro strong(text) -%}<strong>{{ text }}</strong>{%- endmacro %}

{% macro code(text) -%}<code>{{ text }}</code>{%- endmacro %}

{% macro ul(items) -%}
<ul>
{% for i in items %}
<li>{{ i }}</li>
{% endfor %}
</ul>
{% endmacro %}

{% macro ol(items) -%}
<ol>
{% for i in items %}
<li>{{ i }}</li>
{% endfor %}
</ol>
{% endmacro %}

{% macro table(headers, rows) -%}
<table>
<thead><tr>{% for c in headers %}<th>{{ c | cell }}</th>{% endfor %}</tr></thead>
<tbody>
{% for r in rows %}
<tr>{% for c in r %}<td>{{ c | cell }}</td>{% endfor %}</tr>
{% endfor %}
</tbody>
</table>
{% endmacro %}

{% macro kv(pairs) -%}
<table>
<thead><tr><th>Item</th><th>Value</th></tr></thead>
<tbody>
{% for k, v in pairs %}
<tr><th scope="row">{{ k | cell }}</th><td>{{ v | cell }}</td></tr>
{% endfor %}
</tbody>
</table>
{% endmacro %}

{% macro callout(kind, title, body) -%}
<div class="callout"><strong>{{ kind | upper }}: {{ title }}</strong><br>{{ body }}</div>
{% endmacro %}

{% macro review(who, text) -%}
<div class="review"><strong>[REVIEW REQUIRED: {{ who }}]</strong> {{ text }}</div>
{% endmacro %}
