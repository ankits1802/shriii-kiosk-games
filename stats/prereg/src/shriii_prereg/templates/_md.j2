{#- Markdown macro set. The HTML set (_html.j2) exposes the same macro names and signatures. -#}
{% macro doc_start(doc) -%}
---
title: "{{ doc.meta.title | replace('"', "'") }}"
status: {{ doc.meta.status }}
generator: {{ doc.meta.generator }} {{ doc.meta.generator_version }}
generated_at: {{ doc.meta.generated_at }}
inputs:
{% for f in doc.inputs %}
  - { role: {{ f.role }}, path: {{ f.path }}, sha256: {{ f.sha256 }}, version: {{ f.version or 'null' }}, status: {{ f.status or 'null' }} }
{% endfor %}
---

<!-- shriii-prereg-inputs: {{ inputs_json }} -->

{% endmacro %}

{% macro doc_end(doc) -%}

---

Generated by {{ doc.meta.generator }} {{ doc.meta.generator_version }} at {{ doc.meta.generated_at }}. Inputs:
{% for f in doc.inputs %}`{{ f.path }}` sha256 `{{ f.sha256 }}`{% if not loop.last %}; {% endif %}{% endfor %}.
{% endmacro %}

{% macro h(level, text) -%}
{{ '#' * level }} {{ text }}

{% endmacro %}

{% macro p(text) -%}
{{ text }}

{% endmacro %}

{% macro strong(text) -%}**{{ text }}**{%- endmacro %}

{% macro code(text) -%}`{{ text }}`{%- endmacro %}

{% macro ul(items) -%}
{% for i in items %}
- {{ i }}
{% endfor %}

{% endmacro %}

{% macro ol(items) -%}
{% for i in items %}
{{ loop.index }}. {{ i }}
{% endfor %}

{% endmacro %}

{% macro table(headers, rows) -%}
| {% for c in headers %}{{ c | cell }} | {% endfor %}

|{% for c in headers %} --- |{% endfor %}

{% for r in rows %}
| {% for c in r %}{{ c | cell }} | {% endfor %}

{% endfor %}

{% endmacro %}

{% macro kv(pairs) -%}
| Item | Value |
| --- | --- |
{% for k, v in pairs %}
| {{ k | cell }} | {{ v | cell }} |
{% endfor %}

{% endmacro %}

{% macro callout(kind, title, body) -%}
> **{{ kind | upper }}: {{ title }}**
>
> {{ body }}

{% endmacro %}

{% macro review(who, text) -%}
> **[REVIEW REQUIRED: {{ who }}]** {{ text }}

{% endmacro %}
