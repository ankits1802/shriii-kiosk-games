{{ m.doc_start() }}
{{ b.header('Stage 4 fairness and mode equivalence') }}

{{ m.h(2, '1. Purpose and design') }}
{{ m.p('Stage 4 tests whether indicators measure the same thing across groups, following the ITC guidelines: trial-level measurement invariance, DIF with a purified matching variable and FDR control, differential exclusion, ASR accuracy gaps, and supervised vs unattended mode equivalence (required before any open-public release).') }}
{% if inv %}
{{ m.p('Required groupings (gates.yaml trait_gate.invariance): ' ~ (inv.required_groupings | join(', ')) ~ '. At most ' ~ (inv.max_freed_parameter_share | pct) ~ ' of parameters may be freed for partial invariance; groups below n = ' ~ inv.small_group_n ~ ' use Bayesian approximate invariance or moderated MIMIC.') }}
{% endif %}
{% if bg %}
{{ m.p('Battery-level fairness (rule A3): criterion invariance required; no unresolved large DIF for retained indicators; differential exclusion between required groups <= ' ~ (bg.differential_exclusion_max_pp | num) ~ ' percentage points.') }}
{% endif %}
{% if asr %}
{{ m.p('ASR policy: a prompt is voice-enabled only with accuracy >= ' ~ (asr.min_accuracy | pct) ~ ' at ' ~ asr.snr_db ~ ' dB SNR and an age/gender gap <= ' ~ asr.max_group_gap_pp ~ ' pp, with >= ' ~ asr.min_heldout_speakers ~ ' held-out speakers per language.') }}
{% endif %}
{% if min_cell_n is not none %}
{{ m.p('Disclosure control: subgroup results with n < ' ~ min_cell_n ~ ' are suppressed (gates.yaml quality.fairness_cell_min_n). A non-significant difference is never reported as equivalence; equivalence claims use TOST with registered bounds.') }}
{% endif %}

